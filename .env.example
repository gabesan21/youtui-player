# youtui-player reads its real settings from ~/.config/youtui-player/youtui.conf
# (see config-exemples/youtui.conf.example), not from a .env file.
# These are the only environment variables the code looks at, all optional
# XDG base-dir overrides with hardcoded fallbacks — nothing here is required
# or secret.

# Overrides ~/.config for youtui.conf
XDG_CONFIG_HOME=

# Overrides ~/.local/state for state.json
XDG_STATE_HOME=

# Overrides ~/.cache for thumbnail cache
XDG_CACHE_HOME=

# Overrides ~/.local/share for last_url.txt
XDG_DATA_HOME=

# Overrides ~/Downloads as the default download destination
XDG_DOWNLOAD_DIR=

# Locale detection for language auto-selection (falls back to English)
LANG=
LC_ALL=
LC_MESSAGES=
